# Edge-AIGuard Core2 / radar secrets template.
# Copy this file to `esphome/secrets.yaml` and fill in real values
# before flashing or running the pipeline. The real secrets.yaml is
# gitignored.
#
# Generate fresh keys for your install:
#   API key:   openssl rand -base64 32
#   OTA pass:  openssl rand -hex 12

wifi_ssid:     "YourSSID"
wifi_password: "YourWiFiPassword"

# api_password is also exported as CORE2_NOISE_PSK on the Pi side; the
# two MUST match for `--core2` and `--core2-audio` modes to connect.
api_password:  "<base64 from openssl rand -base64 32>"
ota_password:  "<hex from openssl rand -hex 12>"
